<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpAstro.Fonts</RootNamespace>
    <AssemblyName>SharpAstro.Fonts</AssemblyName>
    <PackageId>SharpAstro.Fonts</PackageId>
    <Description>Pure-managed, MIT-licensed C# OpenType / TrueType font loader and rasterizer.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <VersionPrefix>1.4.0</VersionPrefix>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Fonts.Lib.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpAstro.Fonts.Tests" />
  </ItemGroup>

  <!--
    PNG decode for CBDT/sbix bitmap glyphs. SharpAstro fork of StbImageSharp,
    referenced as a sibling project when its working copy exists (fast in-tree
    iteration on the fork itself) and falling back to the published NuGet
    otherwise. Override: dotnet build -p:UseLocalStbImage=false.
  -->
  <PropertyGroup>
    <UseLocalStbImage Condition="'$(UseLocalStbImage)' == '' AND Exists('..\..\..\StbImageSharp\src\StbImageSharp\StbImageSharp.csproj')">true</UseLocalStbImage>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalStbImage)' == 'true'">
    <ProjectReference Include="..\..\..\StbImageSharp\src\StbImageSharp\StbImageSharp.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalStbImage)' != 'true'">
    <PackageReference Include="SharpAstro.StbImage" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
