<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpAstro.Fonts</RootNamespace>
    <AssemblyName>SharpAstro.Fonts</AssemblyName>
    <PackageId>SharpAstro.Fonts</PackageId>
    <Description>Pure-managed, MIT-licensed C# OpenType / TrueType font loader and rasterizer.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No VersionPrefix here: it derives from VersionMajorMinor in the repo-root
         Directory.Build.props, so this package and SharpAstro.Fonts.Shaping cannot disagree.
         Bump it there. -->

    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Fonts.Lib.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpAstro.Fonts.Tests" />
    <!-- First-party shaping satellite (same repo, lockstep versions): parses
         GSUB/GDEF via TryGetTable and reuses the internal BigEndianReader/Tags
         plumbing rather than forcing that IO layer into the public API. -->
    <InternalsVisibleTo Include="SharpAstro.Fonts.Shaping" />
    <InternalsVisibleTo Include="SharpAstro.Fonts.Shaping.Tests" />
  </ItemGroup>

  <!--
    PNG decode for CBDT/sbix bitmap glyphs. Uses the dedicated SharpAstro.Png
    codec (not the whole stb_image port) — referenced as a sibling project when
    its working copy exists (fast in-tree iteration on the codec itself) and
    falling back to the published NuGet otherwise. Both packages live in the
    Codecs repo. Override: dotnet build -p:UseLocalSharpAstroPng=false.
  -->
  <PropertyGroup>
    <UseLocalSharpAstroPng Condition="'$(UseLocalSharpAstroPng)' == '' AND Exists('..\..\..\Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj')">true</UseLocalSharpAstroPng>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroPng)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Png\SharpAstro.Png.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroPng)' != 'true'">
    <PackageReference Include="SharpAstro.Png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
