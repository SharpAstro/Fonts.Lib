<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SharpAstro.Fonts.Shaping</RootNamespace>
    <AssemblyName>SharpAstro.Fonts.Shaping</AssemblyName>
    <PackageId>SharpAstro.Fonts.Shaping</PackageId>
    <Description>Pure-managed OpenType text-shaping engine (GSUB/GPOS/GDEF) over SharpAstro.Fonts. AOT-compatible, no native dependencies. Staged scope: OT-layout core, ligatures/kerning/marks, Arabic joining; Indic/USE out of scope.</Description>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <!-- No VersionPrefix here: it derives from VersionMajorMinor in the repo-root
         Directory.Build.props, so this satellite cannot drift behind SharpAstro.Fonts the way
         DIR.Lib.Shaping drifted behind DIR.Lib. Bump it there. -->

    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SharpAstro/Fonts.Lib.git</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SharpAstro.Fonts.Shaping.Tests" />
    <!-- ScriptLookupBenchmarks measures the internal page-index tables (Script.Ranges/PageIndex,
         UcdTables.RangeU32*) head-to-head against the binary search. -->
    <InternalsVisibleTo Include="SharpAstro.Fonts.Benchmarks" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpAstro.Fonts\SharpAstro.Fonts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\LICENSE" Pack="true" PackagePath="" />
    <None Include="..\..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
