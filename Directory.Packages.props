<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.3.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!-- Phase 6: PNG decode for CBDT/sbix. SharpAstro fork (was StbImageSharp 2.30.15)
         lives at https://github.com/SharpAstro/StbImageSharp, keeps the StbImageSharp
         C# namespace so call sites are unchanged. -->
    <PackageVersion Include="SharpAstro.StbImage" Version="2.30.11" />
    <!-- Benchmarks -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.14.0" />
  </ItemGroup>

</Project>
