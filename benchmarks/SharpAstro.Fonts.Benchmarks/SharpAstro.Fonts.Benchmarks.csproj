<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>SharpAstro.Fonts.Benchmarks</RootNamespace>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires Release for meaningful numbers. -->
    <!-- CA1822: benchmark methods that only touch static tables (e.g. ScriptLookupBenchmarks) are
         still instance methods by BDN convention; don't force `static`. -->
    <NoWarn>$(NoWarn);CA1707;CA1812;CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpAstro.Fonts\SharpAstro.Fonts.csproj" />
    <ProjectReference Include="..\..\src\SharpAstro.Fonts.Shaping\SharpAstro.Fonts.Shaping.csproj" />
  </ItemGroup>

  <!-- Reuse the test fixture fonts (linked, not copied). -->
  <ItemGroup>
    <Content Include="..\..\tests\SharpAstro.Fonts.Tests\Fixtures\**"
             Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
