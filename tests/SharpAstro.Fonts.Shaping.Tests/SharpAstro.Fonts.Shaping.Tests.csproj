<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpAstro.Fonts.Shaping.Tests</RootNamespace>
    <!-- xUnit test method names conventionally use Under_Scores. -->
    <NoWarn>$(NoWarn);CA1707;CA1812;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpAstro.Fonts.Shaping\SharpAstro.Fonts.Shaping.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reuse the core test fixtures (fonts) without duplicating binaries in the repo. -->
    <Content Include="..\SharpAstro.Fonts.Tests\Fixtures\*.ttf" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\SharpAstro.Fonts.Tests\Fixtures\*.otf" Link="Fixtures\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- Golden shaping fixtures generated by tools/HbFixtureGen (real HarfBuzz output). -->
    <Content Include="HbFixtures\**" CopyToOutputDirectory="PreserveNewest" Condition="Exists('HbFixtures')" />
  </ItemGroup>

</Project>
