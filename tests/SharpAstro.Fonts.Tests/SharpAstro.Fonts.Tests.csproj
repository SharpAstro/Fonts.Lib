<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <RootNamespace>SharpAstro.Fonts.Tests</RootNamespace>
    <!-- xUnit test method names conventionally use Under_Scores. -->
    <NoWarn>$(NoWarn);CA1707;CA1812;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <!--
    No direct image-codec reference here: the test suite exercises the color-
    bitmap path through SharpAstro.Fonts' public API and gets SharpAstro.Png
    transitively via the project reference below.
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\SharpAstro.Fonts\SharpAstro.Fonts.csproj" />
  </ItemGroup>

  <!--
    The SVG reader, so that SceneRasterizer can be fed real documents and held against a browser. Since 1.20 the
    library references it too (for the glyphs of an 'SVG ' table); the tests still name it, because they use it directly.
  -->
  <PropertyGroup>
    <UseLocalSharpAstroSvg Condition="'$(UseLocalSharpAstroSvg)' == '' AND Exists('..\..\..\Codecs\src\SharpAstro.Svg\SharpAstro.Svg.csproj')">true</UseLocalSharpAstroSvg>
  </PropertyGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroSvg)' == 'true'">
    <ProjectReference Include="..\..\..\Codecs\src\SharpAstro.Svg\SharpAstro.Svg.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalSharpAstroSvg)' != 'true'">
    <PackageReference Include="SharpAstro.Svg" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Baselines\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
